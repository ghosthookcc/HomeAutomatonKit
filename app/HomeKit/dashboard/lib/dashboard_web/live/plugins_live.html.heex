<div class="min-h-screen w-full bg-[#181a1b] text-gray-200 font-sans">
  <%= if @mode == :menu do %>
    <div class="max-w-6xl mx-auto p-8">
      <header class="flex items-center justify-between mb-10 pb-6 border-b border-[#2d3134]">
        <div>
          <h1 class="text-3xl font-bold text-white tracking-tight">Plugin Manager</h1>
          <p class="text-gray-500 mt-1">Manage and configure your system extensions</p>
        </div>
        <button phx-click="refresh_plugins"
                class="px-4 py-2 rounded-lg bg-[#212425] border border-[#3e4245] text-sm font-medium text-gray-300 hover:bg-[#2d3134] hover:text-white transition-all">
          Refresh List
        </button>
      </header>

      <div class="grid grid-cols-1 gap-4">
        <%= for {name, plugin} <- @plugins do %>
          <div
            class={[
              "group relative rounded-2xl border p-6 transition-all duration-300",
              plugin[:enabled] && "border-blue-500/30 bg-[#1e2227] shadow-[0_8px_30px_rgb(0,0,0,0.12)]",
              !plugin[:enabled] && "border-[#2d3134] bg-[#1d1f21] hover:border-[#3e4245]"
            ]}>
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="text-xl font-semibold text-gray-100 italic">
                    {plugin["atom"]}
                  </h3>
                  <span class="px-2 py-0.5 rounded bg-black/40 text-[10px] font-mono text-blue-400 border border-blue-500/20">
                    v{plugin["version"] || "1.0.0"}
                  </span>
                  <%= if plugin[:enabled] do %>
                    <span class="flex items-center gap-1.5 text-[10px] uppercase tracking-widest text-emerald-500 font-bold">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Active
                    </span>
                  <% end %>
                </div>
                <p class="text-gray-400 leading-relaxed max-w-2xl">
                  <%= plugin["description"] || "No description provided for this extension." %>
                </p>
              </div>

              <div class="flex items-center gap-3">
                <div class="flex items-center gap-3 mr-4 pr-4 border-r border-[#2d3134]">
                   <span class="text-xs font-medium text-gray-500 uppercase tracking-tighter">Status</span>
                   <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" phx-click="toggle_plugin" phx-value-name={plugin["name"]} checked={plugin[:enabled]} class="sr-only peer" />
                    <div class="w-11 h-6 bg-[#363a3d] rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600 shadow-inner"></div>
                  </label>
                </div>

                <div class="flex gap-2">
                  <button phx-click="load_plugin_ui" phx-value-name={plugin["name"]}
                    class="px-4 py-2 rounded-lg bg-[#2d3134] hover:bg-emerald-700 text-xs font-bold uppercase text-gray-300 hover:text-white transition-all border border-[#3e4245]">
                    Test UI
                  </button>
                  <button phx-click="load_plugin" phx-value-name={plugin["name"]}
                    class="px-6 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-xs font-bold uppercase text-white transition-all shadow-lg shadow-blue-900/20">
                    Load
                  </button>
                  <button phx-click="unload_plugin" phx-value-name={plugin["name"]}
                    class="px-4 py-2 rounded-lg bg-[#2d3134] hover:bg-red-900/30 text-xs font-bold uppercase text-gray-400 hover:text-red-400 transition-all border border-[#3e4245]">
                    Unload
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  <% else %>
    <div class="flex flex-col h-screen">
      <nav class="h-20 border-b border-[#2d3134] bg-[#1b1d1e] px-8 flex items-center justify-between">
        <button phx-click="back_to_menu"
          class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors font-medium">
          <span class="text-xl">←</span> Back to Directory
        </button>
        
        <div class="flex items-center gap-4 bg-[#181a1b] px-5 py-2 rounded-full border border-[#2d3134]">
          <span class="text-xs text-gray-500 font-mono uppercase tracking-widest">Instance</span>
          <span class="text-sm font-bold text-blue-400"><%= @plugin_name %></span>
        </div>
      </nav>
      
      <main class="flex-1 overflow-auto p-10">
        <div class="max-w-7xl mx-auto bg-[#1e2021] border border-[#2d3134] rounded-3xl p-10 shadow-2xl min-h-full">
          <%= live_render(@socket, DynamicPluginLive, id: @plugin_key, session: %{"plugin_name" => @plugin_name, "plugin" => @plugin_key}) %>
        </div>
      </main>
    </div>
  <% end %>
</div>
